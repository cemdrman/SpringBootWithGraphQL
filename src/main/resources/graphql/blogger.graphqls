"Blog yazarı. Parola alanı güvenlik nedeniyle şemada yer almaz."
type Blogger {
	id: ID!
	name: String!
	surname: String!
	email: String!
	gender: GenderType
	address: Address
	"Yazarın yazdığı bloglar (DataLoader ile toplu yüklenir)"
	blogList: [Blog!]!
}

input CreateBloggerInput {
	name: String!
	surname: String!
	email: String!
	password: String!
	gender: GenderType
	address: AddressInput
}

extend type Query {
	bloggers: [Blogger!]!
	blogger(id: ID!): Blogger

	getAllBloggers: [Blogger!]! @deprecated(reason: "`bloggers` kullanın.")
	getBlogger(id: ID!): Blogger! @deprecated(reason: "`blogger` kullanın.")
}

extend type Mutation {
	createBlogger(input: CreateBloggerInput!): Blogger!
	"Yalnızca gönderilen alanlar güncellenir."
	updateBlogger(id: ID!, email: String, name: String, surname: String, gender: GenderType, address: AddressInput): Blogger!
	deleteBlogger(id: ID!): Boolean!

	saveBlogger(id: ID!, name: String!, surname: String!, email: String, password: String): Blogger! @deprecated(reason: "`createBlogger` kullanın.")
}
